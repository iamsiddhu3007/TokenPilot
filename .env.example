# TokenPilot — environment template. Copy to .env and fill in.
# NOTE: team LLM provider keys are NOT stored here — each team's key is entered
# in the dashboard and stored encrypted per-project. See PLAN.md.

# === Database (Postgres + pgvector) ===
# Local: the docker compose `db` service. Prod: Neon/Supabase free tier.
DATABASE_URL=postgres://tokenpilot:tokenpilot@localhost:5432/tokenpilot

# === Better Auth (username/password sessions) ===
BETTER_AUTH_SECRET=        # generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# === Secrets ===
# Encrypts per-team provider API keys at rest (AES-256-GCM). base64 32-byte key:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# === LiteLLM gateway (docker compose `litellm` service) ===
# One OpenAI-compatible endpoint in front of all providers. Per-team keys (BYOK)
# are passed at request time from the encrypted store, not stored here.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-tokenpilot-master

# === GitHub App (create it, then fill — see PLAN.md Phase 0b checklist) ===
GITHUB_APP_ID=
GITHUB_APP_SLUG=                  # the app's URL slug (github.com/apps/<slug>)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=           # PEM contents; literal \n between lines is OK
GITHUB_WEBHOOK_SECRET=            # verifies X-Hub-Signature-256 on webhooks

# === Express agent server ===
SERVER_PORT=3001
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
INTERNAL_API_KEY=          # generate: openssl rand -base64 32 — shared between Next.js and Express

# === RabbitMQ (docker compose `rabbitmq` service) ===
RABBITMQ_URL=amqp://tokenpilot:tokenpilot@localhost:5672

# === LangSmith (agent tracing) ===
LANGSMITH_API_KEY=          # get from smith.langchain.com
LANGSMITH_PROJECT=tokenpilot
LANGSMITH_TRACING_V2=true
