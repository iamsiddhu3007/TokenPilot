# TokenPilot — copy to .env and fill in.
# Claude + NVIDIA API keys are entered per-project in the dashboard (encrypted at rest).

# === Database (Postgres + pgvector) ===
DATABASE_URL=postgres://tokenpilot:tokenpilot@localhost:5432/tokenpilot

# === Better Auth ===
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# === Encryption (AES-256-GCM for stored API keys) ===
ENCRYPTION_KEY=            # openssl rand -base64 32

# === GitHub App (optional — needed for live webhook triggers) ===
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=    # PEM contents; use literal \n between lines
GITHUB_WEBHOOK_SECRET=     # leave empty to skip verification in local dev

# === Express agent server ===
SERVER_PORT=3001
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
INTERNAL_API_KEY=          # openssl rand -base64 32

# === RabbitMQ ===
RABBITMQ_URL=amqp://tokenpilot:tokenpilot@localhost:5672

# === LangSmith (agent tracing — free tier at smith.langchain.com) ===
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tokenpilot
LANGSMITH_TRACING_V2=true
